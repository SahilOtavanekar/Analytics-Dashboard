# The table name itself is a fixed app constant (src/db.py: TABLE_FQN), not a secret.
#
# Local development (has a browser to complete SSO interactively):
[connections.snowflake]
account = "your_account_identifier"
user = "your_username@yourcompany.com"
authenticator = "externalbrowser"
role = "R_CIT_DATA_ADMIN"
warehouse = "COMPUTE_WH"
database = "CIT_DATA_CORE"
schema = "TRACKING"

# Headless hosting (e.g. Streamlit Community Cloud) has no browser to complete
# SSO, so use key-pair auth instead: drop the `authenticator` line above and
# add `private_key` with your PEM private key content, e.g.:
#
# [connections.snowflake]
# account = "your_account_identifier"
# user = "your_username@yourcompany.com"
# private_key = """
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# """
# role = "R_CIT_DATA_ADMIN"
# warehouse = "COMPUTE_WH"
# database = "CIT_DATA_CORE"
# schema = "TRACKING"
#
# Streamlit in Snowflake needs no secrets file at all — it auto-detects the
# active Snowpark session automatically inside st.connection("snowflake").
